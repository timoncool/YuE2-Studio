diff --git a/engine/src/legacy-float-charconv.h b/engine/src/legacy-float-charconv.h
new file mode 100644
index 00000000..f6bc9a0e
--- /dev/null
+++ b/engine/src/legacy-float-charconv.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#if defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ < 130300
+#define HOTSTEP_LEGACY_FLOAT_CHARCONV 1
+
+#include "../vendor/yyjson/yyjson.h"
+#include <string>
+
+// Normalize yyjson's shortest round-trip representation of a nonnegative finite double.
+inline std::string hotstep_legacy_float_digits(double value, int & decpt) {
+    char buffer[64];
+    yyjson_mut_val json{};
+    yyjson_mut_set_real(&json, value);
+    size_t length = yyjson_mut_val_write_buf(buffer, sizeof buffer, &json, 0, nullptr);
+    std::string digits(buffer, length);
+    size_t exponent = digits.find_first_of("eE");
+    decpt = 0;
+    if (exponent != std::string::npos) {
+        decpt = std::stoi(digits.substr(exponent + 1));
+        digits.resize(exponent);
+    }
+    size_t dot = digits.find('.');
+    decpt += (int) (dot == std::string::npos ? digits.size() : dot);
+    if (dot != std::string::npos) digits.erase(dot, 1);
+    size_t first = digits.find_first_not_of('0');
+    if (first == std::string::npos) {
+        decpt = 1;
+        return "0";
+    }
+    digits.erase(0, first);
+    digits.resize(digits.find_last_not_of('0') + 1);
+    decpt -= (int) first;
+    return digits;
+}
+#endif
