{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YuE2 Studio",
  "version": "2.1.3",
  "identifier": "com.timoncool.yue2-studio",
  "build": {
    "beforeDevCommand": "npm --prefix ../app run dev",
    "beforeBuildCommand": "npm --prefix ../app run build",
    "devUrl": "http://127.0.0.1:3791",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "create": false,
        "title": "YuE2 Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsi"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNkU1RkQ0RThFNkNFMkEKUldRcXp1Ym8xRjl1R3VaSTRiVTNhVnNzRFFkaGFGMkNzbFRCL1J3TDdTY3JSaVZuT1FRT2pkZGQK",
      "endpoints": [
        "https://github.com/timoncool/YuE2-Studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "YuE2-Studio"
}